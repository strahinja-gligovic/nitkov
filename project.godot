; Engine configuration file.
; Input bindings are registered in code: res://src/core/input_setup.gd

config_version=5

[application]

config/name="Nitkov"
config/description="Original PvP arena brawler prototype: elemental gauntlets, block/parry melee, one stamina pool."
run/main_scene="res://src/world/arena.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

InputSetup="*res://src/core/input_setup.gd"
GameData="*res://src/core/game_data.gd"
CombatEvents="*res://src/core/combat_events.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="fighters"

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
